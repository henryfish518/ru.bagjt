---
/**
 * CtaBand —— 通用底部行动条（深蓝背景 + 橙色主按钮）
 */
import { getLocalizedPath, type Locale } from '@/i18n';
import { whatsappLink } from '@/config';

interface Props {
  locale: Locale;
  title: string;
  subtitle?: string;
  primary?: string;
  secondary?: string;
  /** 主按钮跳转到联系页（默认），或指定 WhatsApp */
  primaryAction?: 'contact' | 'whatsapp';
  secondaryAction?: 'contact' | 'whatsapp' | 'none';
}

const {
  locale,
  title,
  subtitle,
  primary,
  secondary,
  primaryAction = 'contact',
  secondaryAction = 'whatsapp',
} = Astro.props;

const waText =
  locale === 'ru'
    ? 'Здравствуйте! Хочу получить цену на FIBC биг-бэги.'
    : 'Hello! I would like to receive a quotation for FIBC bulk bags.';

const hrefFor = (action: string) =>
  action === 'whatsapp' ? whatsappLink(waText) : getLocalizedPath(locale, 'contact');
---

<section class="bg-brand-600">
  <div class="container-x py-12 lg:py-16">
    <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-brand-700 px-6 py-10 sm:px-10 lg:px-14 lg:py-12">
      <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
      <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-accent-500/20 blur-3xl" aria-hidden="true"></div>

      <div class="relative flex flex-col items-start gap-7 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold leading-tight text-white sm:text-3xl">{title}</h2>
          {subtitle && (
            <p class="mt-3 text-sm leading-relaxed text-brand-200 sm:text-base">{subtitle}</p>
          )}
        </div>

        <div class="flex shrink-0 flex-wrap items-center gap-3">
          {primary && (
            <a
              href={hrefFor(primaryAction)}
              {...(primaryAction === 'whatsapp' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="btn-accent !px-6 !py-3.5 text-base"
            >
              {primary}
            </a>
          )}
          {secondary && secondaryAction !== 'none' && (
            <a
              href={hrefFor(secondaryAction)}
              {...(secondaryAction === 'whatsapp' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="btn-ghost-light !px-6 !py-3.5 text-base"
            >
              {secondary}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
