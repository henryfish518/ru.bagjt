---
/**
 * Header —— 顶部导航栏
 * -----------------------------------------------------------------------------
 *  - 左侧：Logo + 公司简称
 *  - 中间：主导航（首页 / 产品 / 关于我们 / 联系我们）
 *  - 右侧：RU / EN 语言切换器 + "询价" CTA
 *  - 移动端：汉堡菜单（纯 CSS + 少量原生 JS，无框架依赖）
 */
import {
  useTranslations,
  getLocalizedPath,
  getOtherLocale,
  LOCALE_SHORT,
  LOCALE_LABEL,
  type Locale,
} from '@/i18n';
import { NAV_ITEMS, telegramLink } from '@/config';

interface Props {
  locale: Locale;
  slug?: string;
}

const { locale, slug = '' } = Astro.props;
const t = useTranslations(locale);
const other = getOtherLocale(locale);

/** 语言切换后的目标地址：保持停留在同一页面 */
const switchHref = getLocalizedPath(other, slug);

/** 当前页高亮判断 */
const isActive = (itemSlug: string) => itemSlug === slug;
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <!-- 顶部细条：联系方式提示（小屏隐藏） -->
  <div class="hidden bg-brand-700 text-white lg:block">
    <div class="container-x flex h-9 items-center justify-between text-xs">
      <p class="truncate font-medium tracking-wide">
        {t.brand.tagline}
      </p>
      <div class="flex items-center gap-5">
        <a href={telegramLink()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-accent-300 transition-colors">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          {t.common.whatsapp}
        </a>
        <a href={getLocalizedPath(locale, 'contact')} class="hover:text-accent-300 transition-colors">
          {t.common.contactUs}
        </a>
      </div>
    </div>
  </div>

  <div class="container-x flex h-16 items-center justify-between gap-4 lg:h-[72px]">
    <!-- Logo -->
    <a href={getLocalizedPath(locale)} class="flex shrink-0 items-center gap-2.5" aria-label={t.meta.siteName}>
      <!-- 占位 Logo：可用真实 SVG/PNG 替换 public/logo.svg -->
      <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 shadow-sm">
        <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 3h8l1 4v12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V7l1-4Z" />
          <path d="M7.2 7h9.6" />
          <path d="M10.5 11h3" />
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-[15px] font-extrabold tracking-tight text-brand-700 sm:text-base">
          {t.brand.name}
        </span>
        <span class="mt-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-500">
          bagjt.com
        </span>
      </span>
    </a>

    <!-- 桌面端主导航 -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
      {NAV_ITEMS.map((item) => (
        <a
          href={getLocalizedPath(locale, item.slug)}
          aria-current={isActive(item.slug) ? 'page' : undefined}
          class:list={[
            'relative rounded-md px-3.5 py-2 text-sm font-semibold transition-colors',
            isActive(item.slug)
              ? 'text-brand-700 after:absolute after:inset-x-3.5 after:-bottom-[1px] after:h-0.5 after:rounded-full after:bg-accent-500'
              : 'text-slate-600 hover:bg-brand-50 hover:text-brand-700',
          ]}
        >
          {t.nav[item.key]}
        </a>
      ))}
    </nav>

    <!-- 右侧操作区 -->
    <div class="flex items-center gap-2">
      <!-- ============ RU / EN 语言切换器 ============ -->
      <div class="flex items-center rounded-lg border border-slate-200 bg-slate-50 p-0.5" role="group" aria-label={t.common.langSwitchLabel}>
        <span
          class="rounded-md bg-white px-2.5 py-1.5 text-xs font-bold text-brand-700 shadow-sm"
          aria-current="true"
        >
          {LOCALE_SHORT[locale]}
        </span>
        <a
          href={switchHref}
          hreflang={other}
          lang={other}
          class="rounded-md px-2.5 py-1.5 text-xs font-bold text-slate-500 transition-colors hover:bg-white hover:text-brand-600"
          title={`${t.common.switchTo} — ${LOCALE_LABEL[other]}`}
        >
          {LOCALE_SHORT[other]}
        </a>
      </div>

      <!-- CTA -->
      <a href={getLocalizedPath(locale, 'contact')} class="btn-accent hidden !px-4 !py-2.5 md:inline-flex">
        {t.common.getQuote}
      </a>

      <!-- 移动端菜单按钮 -->
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-brand-700 transition-colors hover:bg-brand-50 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle menu"
      >
        <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 移动端下拉导航 -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-slate-200 bg-white lg:hidden"
    aria-label="Mobile navigation"
  >
    <div class="container-x flex flex-col py-3">
      {NAV_ITEMS.map((item) => (
        <a
          href={getLocalizedPath(locale, item.slug)}
          aria-current={isActive(item.slug) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-3 text-sm font-semibold transition-colors',
            isActive(item.slug) ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50',
          ]}
        >
          {t.nav[item.key]}
        </a>
      ))}
      <div class="mt-2 flex items-center gap-2 border-t border-slate-100 pt-3">
        <a href={getLocalizedPath(locale, 'contact')} class="btn-accent flex-1">
          {t.common.getQuote}
        </a>
        <a
          href={switchHref}
          hreflang={other}
          lang={other}
          class="btn-outline !px-4"
          title={`${t.common.switchTo} — ${LOCALE_LABEL[other]}`}
        >
          {LOCALE_SHORT[other]}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // 移动端菜单开关（原生 JS，无框架依赖）
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.classList.toggle('hidden', isOpen);
      iconOpen?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
    });
  }
</script>
